/*
  ! Access-Control-Allow-Origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; script-src https:; style-src 'unsafe-inline' https:; img-src data: https:; font-src https:; connect-src *; media-src https:; worker-src 'self'; form-action 'self'; frame-ancestors 'none';
